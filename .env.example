LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
PORT=8000

# Agent runtime hard bounds. Defaults are shown; remove a line to use the default.
AGENT_TIMEOUT_S=180
AGENT_MAX_TURNS=6
AGENT_READ_ONLY_RETRIES=1
AGENT_RETRY_BACKOFF_S=0.5
AGENT_TOKEN_BUDGET=32000

# Light Investigation Planner transport. "auto" first tries a Function Tool and
# falls back to strictly validated JSON if the OpenAI-compatible gateway rejects it.
LIGHT_PLANNER_TRANSPORT=auto

# Optional accounting only. Fill these with the actual gateway/model price if known.
# LLM_INPUT_COST_PER_MILLION=
# LLM_OUTPUT_COST_PER_MILLION=
