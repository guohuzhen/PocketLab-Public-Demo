.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.hypothesis/
.tox/
.nox/
.deepeval/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/
.uv-cache/
pip-wheel-metadata/
build/
dist/
wheels/

# JavaScript/frontend package caches and generated bundles
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.next/
.nuxt/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# HarmonyOS / DevEco local state and generated application packages
.hvigor/
**/.hvigor/
oh_modules/
**/oh_modules/
local.properties
**/local.properties
.preview/
**/.preview/
*.hap
*.hsp

# Editors, local coding-agent state and OS metadata
.codex/
.codex-tmp/
.claude/
.cursor/
.idea/
.vscode/
*.code-workspace
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Generic scratch files and recoverable editor backups
tmp/
temp/
.tmp/
.temp/
*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej
*.swp
*.swo
*~

# Local headless-browser/render QA scratch (never product assets)
tmp_edge_profile*/
tmp_acquisition_*.png
tmp_edge_dump*.txt
